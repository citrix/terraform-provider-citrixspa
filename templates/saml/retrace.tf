# Retrace — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_retrace_s1_stackify_com" {
  fqdn         = "s1.stackify.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Retrace"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_retrace_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Retrace"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_retrace" {
  name         = "Retrace"
  type         = "saas"
  state        = "complete"
  description  = "Application performance management to integrate code profiling, error tracking, application logs, and metrics."
  url          = "https://s1.stackify.com/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Retrace"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://s1.stackify.com/sso/saml2?clienttoken=<customer_id>"
    audience          = "https://s1.stackify.com/sso"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_retrace_s1_stackify_com,
    citrixspa_routing_domain.rd_retrace_customer_fqdn,
  ]
}
