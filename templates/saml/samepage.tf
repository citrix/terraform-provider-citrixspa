# Samepage — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_samepage_samepage_io" {
  fqdn         = "samepage.io"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Samepage"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_samepage_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Samepage"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_samepage" {
  name         = "Samepage"
  type         = "saas"
  state        = "complete"
  description  = "Collaboration software to manage online projects."
  url          = "https://samepage.io"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Samepage"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://samepage.io/api/sso/saml20"
    audience          = "https://samepage.io"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_samepage_samepage_io,
    citrixspa_routing_domain.rd_samepage_customer_fqdn,
  ]
}
