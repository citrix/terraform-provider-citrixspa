# Branch — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_branch_dashboard_branch_io" {
  fqdn         = "dashboard.branch.io"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Branch"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_branch_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Branch"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_branch" {
  name         = "Branch"
  type         = "saas"
  state        = "complete"
  description  = "Branch - A mobile linking platform powering deep links and mobile."
  url          = "https://dashboard.branch.io/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Branch"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.dashboard.branch.io/"
    audience          = "https://<customer-domain>.dashboard.branch.io/"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "firstName"
        value = "aaa.user.attribute(\"givenName\")"
      },
      {
        name  = "email"
        value = "ns_user_email"
      },
      {
        name  = "lastName"
        value = "aaa.user.attribute(\"sn\")"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_branch_dashboard_branch_io,
    citrixspa_routing_domain.rd_branch_customer_fqdn,
  ]
}
