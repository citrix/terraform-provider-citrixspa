# Easy Projects — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_easy_projects_customer_domain_go_easyprojects_net" {
  fqdn         = "<customer-domain>.go.easyprojects.net"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Easy Projects"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_easy_projects_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Easy Projects"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_easy_projects" {
  name         = "Easy Projects"
  type         = "saas"
  state        = "complete"
  description  = "Project Management software"
  url          = "https://<customer-domain>.go.easyprojects.net/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Easy Projects"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.go.easyprojects.net/AuthServices/Acs"
    audience          = "https://ssosaml.easyprojects.net/AuthServices"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_easy_projects_customer_domain_go_easyprojects_net,
    citrixspa_routing_domain.rd_easy_projects_customer_fqdn,
  ]
}
