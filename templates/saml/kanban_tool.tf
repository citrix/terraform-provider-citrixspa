# Kanban Tool — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_kanban_tool_customer_domain_kanbantool_com" {
  fqdn         = "<customer-domain>.kanbantool.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Kanban Tool"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_kanban_tool_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Kanban Tool"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_kanban_tool" {
  name         = "Kanban Tool"
  type         = "saas"
  state        = "complete"
  description  = "Visual management software to improve your team performance and boost productivity."
  url          = "https://<customer-domain>.kanbantool.com/b/433121#?"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Kanban Tool"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.kanbantool.com/saml/complete"
    audience          = "https://<customer-domain>.kanbantool.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_kanban_tool_customer_domain_kanbantool_com,
    citrixspa_routing_domain.rd_kanban_tool_customer_fqdn,
  ]
}
