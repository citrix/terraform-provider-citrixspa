# Kintone — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_kintone_your_organization_kintone_com" {
  fqdn         = "<your-organization>.kintone.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Kintone"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_kintone_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Kintone"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_kintone" {
  name         = "Kintone"
  type         = "saas"
  state        = "complete"
  description  = "Custom workflows and data management in one place"
  url          = "https://<your-organization>.kintone.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Kintone"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.kintone.com/saml/acs"
    audience          = "https://<your-organization>.kintone.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "unspecified"
    saml_type         = "SP"
    sp_initiated_only = true
  }

  depends_on = [
    citrixspa_routing_domain.rd_kintone_your_organization_kintone_com,
    citrixspa_routing_domain.rd_kintone_customer_fqdn,
  ]
}
