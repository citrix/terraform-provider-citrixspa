# Digicert — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_digicert_www_digicert_com" {
  fqdn         = "www.digicert.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Digicert"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_digicert_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Digicert"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_digicert" {
  name         = "Digicert"
  type         = "saas"
  state        = "complete"
  description  = "Certificate management and troubleshooting tool for SSL certificates for websites."
  url          = "https://www.digicert.com/secure/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Digicert"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://www.digicert.com/account/sso/"
    audience          = "https://www.digicert.com/account/sso/metadata"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_digicert_www_digicert_com,
    citrixspa_routing_domain.rd_digicert_customer_fqdn,
  ]
}
