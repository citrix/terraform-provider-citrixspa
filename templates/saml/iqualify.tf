# iQualify — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_iqualify_your_organisation_iqualify_com" {
  fqdn         = "<your-organisation>.iqualify.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "iQualify"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_iqualify_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "iQualify"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_iqualify" {
  name         = "iQualify"
  type         = "saas"
  state        = "complete"
  description  = "One - Learning and management tool to delivers authentic learning experiences."
  url          = "https://<your-organisation>.iqualify.com/login"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "iQualify"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organisation>.iqualify.com/auth/saml2/callback"
    audience          = "https://<your-organisation>.iqualify.com"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name   = "first_name"
        value  = "ns_user_name"
        format = "basic"
      },
      {
        name   = "last_name"
        value  = "aaa.USER.ATTRIBUTE(\"sn\")"
        format = "basic"
      },
      {
        name   = "email"
        value  = "ns_user_email"
        format = "basic"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_iqualify_your_organisation_iqualify_com,
    citrixspa_routing_domain.rd_iqualify_customer_fqdn,
  ]
}
