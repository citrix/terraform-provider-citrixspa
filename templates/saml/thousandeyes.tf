# ThousandEyes — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_thousandeyes_app_thousandeyes_com" {
  fqdn         = "app.thousandeyes.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ThousandEyes"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_thousandeyes_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ThousandEyes"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_thousandeyes" {
  name         = "ThousandEyes"
  type         = "saas"
  state        = "complete"
  description  = "Tool to monitor network infrastructure, troubleshoot application delivery, and map internet performance."
  url          = "https://app.thousandeyes.com/dashboard/?dashboardId=0"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "ThousandEyes"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.thousandeyes.com/login/sso/acs"
    audience          = "https://app.thousandeyes.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_thousandeyes_app_thousandeyes_com,
    citrixspa_routing_domain.rd_thousandeyes_customer_fqdn,
  ]
}
