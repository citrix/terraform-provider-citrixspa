# OpsGenie — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_opsgenie_www_customer_domain_opsgenie_com" {
  fqdn         = "www.<customer-domain>.opsgenie.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "OpsGenie"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_opsgenie_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "OpsGenie"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_opsgenie" {
  name         = "OpsGenie"
  type         = "saas"
  state        = "complete"
  description  = "Incident management platform for DevOps and IT Ops teams to streamline alerts and incident resolution processes."
  url          = "https://www.<customer-domain>.opsgenie.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "OpsGenie"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.opsgenie.com/auth/saml?id=<customer_id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_opsgenie_www_customer_domain_opsgenie_com,
    citrixspa_routing_domain.rd_opsgenie_customer_fqdn,
  ]
}
