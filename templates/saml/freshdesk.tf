# Freshdesk — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_freshdesk_customer_domain_freshdesk_com" {
  fqdn         = "<customer-domain>.freshdesk.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Freshdesk"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_freshdesk_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Freshdesk"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_freshdesk" {
  name         = "Freshdesk"
  type         = "saas"
  state        = "complete"
  description  = "Customer support tool to help support the needs of customers."
  url          = "https://<customer-domain>.freshdesk.com/a/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Freshdesk"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.freshdesk.com/login/saml"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_freshdesk_customer_domain_freshdesk_com,
    citrixspa_routing_domain.rd_freshdesk_customer_fqdn,
  ]
}
