# TextExpander — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_textexpander_app_textexpander_com" {
  fqdn         = "app.textexpander.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "TextExpander"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_textexpander_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "TextExpander"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_textexpander" {
  name         = "TextExpander"
  type         = "saas"
  state        = "complete"
  description  = "Communication tool to insert snippets of text from a repository of emails, and other content, as you type."
  url          = "https://app.textexpander.com/ssoSignin"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "TextExpander"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.textexpander.com/acs/<customer_id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_textexpander_app_textexpander_com,
    citrixspa_routing_domain.rd_textexpander_customer_fqdn,
  ]
}
