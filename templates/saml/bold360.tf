# Bold360 — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_bold360_web_boldchat_com" {
  fqdn         = "web.boldchat.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Bold360"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_bold360_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Bold360"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_bold360" {
  name         = "Bold360"
  type         = "saas"
  state        = "complete"
  description  = "Live chat tool for customer engagement."
  url          = "https://web.boldchat.com/aid/<customer_id>/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Bold360"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://web.boldchat.com/aid/<customer_id>/"
    audience          = "https://web.boldchat.com/aid/<customer_id>/"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_bold360_web_boldchat_com,
    citrixspa_routing_domain.rd_bold360_customer_fqdn,
  ]
}
