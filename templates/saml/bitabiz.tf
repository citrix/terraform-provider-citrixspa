# BitaBIZ — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_bitabiz_www_bitabiz_com" {
  fqdn         = "www.bitabiz.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "BitaBIZ"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_bitabiz_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "BitaBIZ"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_bitabiz" {
  name         = "BitaBIZ"
  type         = "saas"
  state        = "complete"
  description  = "Absence and vacation planning and communication tool for leave and absence management."
  url          = "https://www.bitabiz.com/dashboard"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "BitaBIZ"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://www.bitabiz.com/api/saml/auth"
    audience          = "https://www.bitabiz.com/<Org-ID>"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_bitabiz_www_bitabiz_com,
    citrixspa_routing_domain.rd_bitabiz_customer_fqdn,
  ]
}
