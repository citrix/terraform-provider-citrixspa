# TestingBot — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_testingbot_app_teem_com" {
  fqdn         = "app.teem.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "TestingBot"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_testingbot_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "TestingBot"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_testingbot" {
  name         = "TestingBot"
  type         = "saas"
  state        = "complete"
  description  = "Cross Browser Selenium Testing Online"
  url          = "https://app.teem.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "TestingBot"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://testingbot.com/users/saml/auth"
    audience          = "https://testingbot.com/users/saml/metadata"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "transient"
    saml_type         = "IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "first_name"
        value = "aaa.user.attribute(\"givenName\")"
      },
      {
        name  = "email"
        value = "ns_user_email"
      },
      {
        name  = "last_name"
        value = "aaa.user.attribute(\"sn\")"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_testingbot_app_teem_com,
    citrixspa_routing_domain.rd_testingbot_customer_fqdn,
  ]
}
