# When I Work — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_when_i_work_your_organization_wheniwork_com" {
  fqdn         = "<your-organization>.wheniwork.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "When I Work"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_when_i_work_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "When I Work"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_when_i_work" {
  name         = "When I Work"
  type         = "saas"
  state        = "complete"
  description  = "Tool for employee scheduling and time tracking."
  url          = "https://<your-organization>.wheniwork.com/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "When I Work"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.wheniwork.com/rest/saml/auth/<account-id>"
    audience          = "https://saml.wheniwork.com/<account-id>"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name   = "firstName"
        value  = "ns_user_name"
        format = "unspecified"
      },
      {
        name   = "lastName"
        value  = "aaa.USER.ATTRIBUTE(\"sn\")"
        format = "unspecified"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_when_i_work_your_organization_wheniwork_com,
    citrixspa_routing_domain.rd_when_i_work_customer_fqdn,
  ]
}
