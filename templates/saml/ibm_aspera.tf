# IBM Aspera — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_ibm_aspera_idaas_iam_ibm_com" {
  fqdn         = "idaas.iam.ibm.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "IBM Aspera"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_ibm_aspera_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "IBM Aspera"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_ibm_aspera" {
  name         = "IBM Aspera"
  type         = "saas"
  state        = "complete"
  description  = "Move and share big files and data across any distance at maximum speed"
  url          = "https://idaas.iam.ibm.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "IBM Aspera"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://api.ibmaspera.com/api/v1/oauth2/<your-OrgID>/saml/<SP-ProvidedID>/callback"
    audience          = "https://api.ibmaspera.com/api/v1/oauth2/<your-OrgID>/saml/<SP-ProvidedID>/metadata"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "unspecified"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name   = "fname"
        value  = "ns_user_name"
        format = "basic"
      },
      {
        name   = "lname"
        value  = "aaa.USER.ATTRIBUTE(\"sn\")"
        format = "basic"
      },
      {
        name   = "email"
        value  = "ns_user_email"
        format = "basic"
      },
      {
        name   = "memberOf"
        value  = "ns_user_email"
        format = "basic"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_ibm_aspera_idaas_iam_ibm_com,
    citrixspa_routing_domain.rd_ibm_aspera_customer_fqdn,
  ]
}
