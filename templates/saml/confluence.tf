# Confluence — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_confluence_your_organization_atlassian_net" {
  fqdn         = "<your-organization>.atlassian.net"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Confluence"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_confluence_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Confluence"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_confluence" {
  name         = "Confluence"
  type         = "saas"
  state        = "complete"
  description  = "Content collaboration tool to help teams collaborate and share knowledge."
  url          = "https://<your-organization>.atlassian.net"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Confluence"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://auth.atlassian.com/login/callback?connection=saml-<your-org-id>"
    audience          = "https://auth.atlassian.com/saml/<your-org-id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "givenname"
        value = "aaa.USER.ATTRIBUTE(\"givenName\")"
      },
      {
        name  = "surname"
        value = "aaa.USER.ATTRIBUTE(\"sn\")"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_confluence_your_organization_atlassian_net,
    citrixspa_routing_domain.rd_confluence_customer_fqdn,
  ]
}
