# SmarterU — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_smarteru_your_org_hostname_smarteru_com" {
  fqdn         = "<your-org-Hostname>.smarteru.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "SmarterU"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_smarteru_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "SmarterU"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_smarteru" {
  name         = "SmarterU"
  type         = "saas"
  state        = "complete"
  description  = "Learning management system LMS to train customers and employees."
  url          = "http://<your-org-Hostname>.smarteru.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "SmarterU"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://integrations.smarteru.com/integrations/saml/"
    audience          = "https://integrations.smarteru.com"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_smarteru_your_org_hostname_smarteru_com,
    citrixspa_routing_domain.rd_smarteru_customer_fqdn,
  ]
}
