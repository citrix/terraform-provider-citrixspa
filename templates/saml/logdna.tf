# LogDNA — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_logdna_app_logdna_com" {
  fqdn         = "app.logdna.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "LogDNA"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_logdna_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "LogDNA"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_logdna" {
  name         = "LogDNA"
  type         = "saas"
  state        = "complete"
  description  = "Tool to collect, monitor, parse, and analyze logs from all sources in one centralized logging tool."
  url          = "https://app.logdna.com/<customer_id>/logs/dashboard"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "LogDNA"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.logdna.com/auth/saml-consume/<customer_id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_logdna_app_logdna_com,
    citrixspa_routing_domain.rd_logdna_customer_fqdn,
  ]
}
