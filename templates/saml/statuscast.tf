# StatusCast — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_statuscast_your_organization_statuscast_com" {
  fqdn         = "<your-organization>.statuscast.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "StatusCast"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_statuscast_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "StatusCast"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_statuscast" {
  name         = "StatusCast"
  type         = "saas"
  state        = "complete"
  description  = "Hosted status page to keep your employees and customers aware about downtime and website maintenance."
  url          = "https://<your-organization>.statuscast.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "StatusCast"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.statuscast.com/sso/saml"
    audience          = "https://<your-organization>.statuscast.com/sso/saml"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_statuscast_your_organization_statuscast_com,
    citrixspa_routing_domain.rd_statuscast_customer_fqdn,
  ]
}
