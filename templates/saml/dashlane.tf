# Dashlane — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_dashlane_console_dashlane_com" {
  fqdn         = "console.dashlane.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Dashlane"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_dashlane_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Dashlane"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_dashlane" {
  name         = "Dashlane"
  type         = "saas"
  state        = "complete"
  description  = "Password management tool that also manages digital wallets."
  url          = "https://console.dashlane.com/members"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Dashlane"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://ws1.dashlane.com/1/teamPlans/verifyAndAddMemberFromIdp"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_dashlane_console_dashlane_com,
    citrixspa_routing_domain.rd_dashlane_customer_fqdn,
  ]
}
