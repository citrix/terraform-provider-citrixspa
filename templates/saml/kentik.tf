# Kentik — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_kentik_portal_kentik_com" {
  fqdn         = "portal.kentik.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Kentik"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_kentik_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Kentik"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_kentik" {
  name         = "Kentik"
  type         = "saas"
  state        = "complete"
  description  = "Tool to leverage big data for network and performance monitoring, DDoS protection, and real-time ad-hoc network flow analytics."
  url          = "https://portal.kentik.com/library"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Kentik"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://portal.kentik.com/sso/consume/<company_id>"
    audience          = "https://portal.kentik.com/sp/<company_id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_kentik_portal_kentik_com,
    citrixspa_routing_domain.rd_kentik_customer_fqdn,
  ]
}
