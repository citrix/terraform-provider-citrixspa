# CA Flowdock — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_ca_flowdock_www_flowdock_com" {
  fqdn         = "www.flowdock.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "CA Flowdock"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_ca_flowdock_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "CA Flowdock"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_ca_flowdock" {
  name         = "CA Flowdock"
  type         = "saas"
  state        = "complete"
  description  = "Collaboration tool for teams to converse and collaborate."
  url          = "https://www.flowdock.com/login"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "CA Flowdock"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "<ACS-Url provided by flowdock>"
    audience          = "<flowdock-application-url>"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name   = "first_name"
        value  = "ns_user_name"
        format = "basic"
      },
      {
        name   = "last_name"
        value  = "aaa.USER.ATTRIBUTE(\"sn\")"
        format = "basic"
      },
      {
        name   = "email"
        value  = "ns_user_email"
        format = "basic"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_ca_flowdock_www_flowdock_com,
    citrixspa_routing_domain.rd_ca_flowdock_customer_fqdn,
  ]
}
