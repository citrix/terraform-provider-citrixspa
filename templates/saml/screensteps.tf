# ScreenSteps — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_screensteps_customer_domain_screenstepslive_com" {
  fqdn         = "<customer-domain>.screenstepslive.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ScreenSteps"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_screensteps_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ScreenSteps"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_screensteps" {
  name         = "ScreenSteps"
  type         = "saas"
  state        = "complete"
  description  = "Tools to create visual documents centered on screen captures."
  url          = "http://<customer-domain>.screenstepslive.com/admin/v2/sites/dashboard"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "ScreenSteps"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.screenstepslive.com/saml/consume/<customer_id>"
    audience          = "ScreenSteps-Live"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_screensteps_customer_domain_screenstepslive_com,
    citrixspa_routing_domain.rd_screensteps_customer_fqdn,
  ]
}
