# PurelyHR — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_purelyhr_my_purelyhr_com" {
  fqdn         = "my.purelyhr.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "PurelyHR"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_purelyhr_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "PurelyHR"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_purelyhr" {
  name         = "PurelyHR"
  type         = "saas"
  state        = "complete"
  description  = "Leave management tool for accessing employee leave data."
  url          = "https://my.purelyhr.com/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "PurelyHR"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<companyID>.purelyhr.com/sso-consume"
    audience          = "https://my.purelyhr.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "Email"
        value = "ns_user_email"
      },
      {
        name  = "Firstname"
        value = "aaa.user.attribute(\"givenName\")"
      },
      {
        name  = "Lastname"
        value = "aaa.user.attribute(\"sn\")"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_purelyhr_my_purelyhr_com,
    citrixspa_routing_domain.rd_purelyhr_customer_fqdn,
  ]
}
