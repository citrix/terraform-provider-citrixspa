# PlanMyLeave — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_planmyleave_live1_planmyleave_com" {
  fqdn         = "live1.planmyleave.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "PlanMyLeave"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_planmyleave_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "PlanMyLeave"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_planmyleave" {
  name         = "PlanMyLeave"
  type         = "saas"
  state        = "complete"
  description  = "Leave management system for managing and tracking leave of absence of employee."
  url          = "https://live1.planmyleave.com/DashBoard/FillDashBoard"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "PlanMyLeave"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.PlanMyLeave.com/samllogin.aspx"
    audience          = "https://<customer-domain>.PlanMyLeave.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP"
    sp_initiated_only = true
  }

  depends_on = [
    citrixspa_routing_domain.rd_planmyleave_live1_planmyleave_com,
    citrixspa_routing_domain.rd_planmyleave_customer_fqdn,
  ]
}
