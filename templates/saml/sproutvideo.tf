# SproutVideo — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_sproutvideo_customer_domain_vids_io" {
  fqdn         = "<customer-domain>.vids.io"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "SproutVideo"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_sproutvideo_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "SproutVideo"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_sproutvideo" {
  name         = "SproutVideo"
  type         = "saas"
  state        = "complete"
  description  = "Platform to host business videos."
  url          = "https://<customer-domain>.vids.io"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "SproutVideo"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.vids.io/saml/consume"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_sproutvideo_customer_domain_vids_io,
    citrixspa_routing_domain.rd_sproutvideo_customer_fqdn,
  ]
}
