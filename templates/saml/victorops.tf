# VictorOps — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_victorops_portal_victorops_com" {
  fqdn         = "portal.victorops.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "VictorOps"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_victorops_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "VictorOps"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_victorops" {
  name         = "VictorOps"
  type         = "saas"
  state        = "complete"
  description  = "Incident management software to provide DevOps observability, collaboration, and real-time alerting."
  url          = "https://portal.victorops.com/client/<organization_key>"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "VictorOps"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://sso.victorops.com/sp/ACS.saml2"
    audience          = "victorops.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_victorops_portal_victorops_com,
    citrixspa_routing_domain.rd_victorops_customer_fqdn,
  ]
}
