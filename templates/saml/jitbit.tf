# JitBit — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_jitbit_customer_domain_jitbit_com" {
  fqdn         = "<Customer-domain>.jitbit.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "JitBit"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_jitbit_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "JitBit"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_jitbit" {
  name         = "JitBit"
  type         = "saas"
  state        = "complete"
  description  = "Help desk software and ticketing system to manage and track incoming support request emails as well as their associated tickets."
  url          = "https://<Customer-domain>.jitbit.com/helpdesk/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "JitBit"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<Customer-domain>.jitbit.com/helpdesk/Saml/Consume"
    audience          = "https://www.jitbit.com/web-helpdesk/"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_jitbit_customer_domain_jitbit_com,
    citrixspa_routing_domain.rd_jitbit_customer_fqdn,
  ]
}
