# SENDSAFELY — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_sendsafely_your_org_hostname_sendsafely_com" {
  fqdn         = "<your-org-Hostname>.sendsafely.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "SENDSAFELY"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_sendsafely_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "SENDSAFELY"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_sendsafely" {
  name         = "SENDSAFELY"
  type         = "saas"
  state        = "complete"
  description  = "Encryption platform for secure exchange of files and emails."
  url          = "https://<your-org-Hostname>.sendsafely.com/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "SENDSAFELY"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-org-Hostname>.sendsafely.com/auth/saml2/"
    audience          = "https://<your-org-Hostname>.sendsafely.com"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_sendsafely_your_org_hostname_sendsafely_com,
    citrixspa_routing_domain.rd_sendsafely_customer_fqdn,
  ]
}
