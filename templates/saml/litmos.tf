# Litmos — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_litmos_your_organization_litmos_com" {
  fqdn         = "<your-organization>.litmos.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Litmos"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_litmos_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Litmos"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_litmos" {
  name         = "Litmos"
  type         = "saas"
  state        = "complete"
  description  = "Learning management system for employee training, customer training, compliance training, and partner training."
  url          = "https://<your-organization>.litmos.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Litmos"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.litmos.com/integration/samllogin"
    audience          = "https://<your-organization>.litmos.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "Email"
        value = "ns_user_email"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_litmos_your_organization_litmos_com,
    citrixspa_routing_domain.rd_litmos_customer_fqdn,
  ]
}
