# Workstars — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_workstars_customer_domain_workstar_com" {
  fqdn         = "<customer-domain>.workstar.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Workstars"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_workstars_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Workstars"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_workstars" {
  name         = "Workstars"
  type         = "saas"
  state        = "complete"
  description  = "Platform for social and peer employee recognition programs."
  url          = "https://<customer-domain>.workstar.com/admin/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Workstars"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.workstars.com/saml/login_check"
    audience          = "https://workstars.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_workstars_customer_domain_workstar_com,
    citrixspa_routing_domain.rd_workstars_customer_fqdn,
  ]
}
