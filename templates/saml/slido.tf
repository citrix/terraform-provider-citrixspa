# slido — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_slido_www_slido_com" {
  fqdn         = "www.slido.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "slido"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_slido_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "slido"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_slido" {
  name         = "slido"
  type         = "saas"
  state        = "complete"
  description  = "Audience Interaction Made Easy"
  url          = "https://www.slido.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "slido"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://api.sli.do/latest/oauth/saml"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP"
    sp_initiated_only = true

    custom_attributes = [
      {
        name   = "name"
        value  = "ns_user_name"
        format = "uri"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_slido_www_slido_com,
    citrixspa_routing_domain.rd_slido_customer_fqdn,
  ]
}
