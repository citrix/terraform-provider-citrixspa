# Assembla — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_assembla_customer_domain_assembla_com" {
  fqdn         = "<customer-domain>.assembla.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Assembla"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_assembla_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Assembla"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_assembla" {
  name         = "Assembla"
  type         = "saas"
  state        = "complete"
  description  = "Version control and source code management tool for software development."
  url          = "https://<customer-domain>.assembla.com/p/home"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Assembla"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.assembla.com/p/saml/consume"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_assembla_customer_domain_assembla_com,
    citrixspa_routing_domain.rd_assembla_customer_fqdn,
  ]
}
