# Podbean — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_podbean_www_podbean_com" {
  fqdn         = "www.podbean.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Podbean"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_podbean_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Podbean"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_podbean" {
  name         = "Podbean"
  type         = "saas"
  state        = "complete"
  description  = "Free Podcast Hosting - Starting a Podcast in 5 Minutes"
  url          = "https://www.podbean.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Podbean"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://www.podbean.com/saml/module.php/saml/sp/saml2-acs.php/podbean"
    audience          = "https://www.podbean.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "unspecified"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_podbean_www_podbean_com,
    citrixspa_routing_domain.rd_podbean_customer_fqdn,
  ]
}
