# Resource Guru — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_resource_guru_customer_domain_resourceguruapp_com" {
  fqdn         = "<Customer-domain>.resourceguruapp.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Resource Guru"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_resource_guru_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Resource Guru"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_resource_guru" {
  name         = "Resource Guru"
  type         = "saas"
  state        = "complete"
  description  = "Resource management software to schedule people, equipment and other resources."
  url          = "https://<Customer-domain>.resourceguruapp.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Resource Guru"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<Customer-domain>.resourceguruapp.com/sso/acs"
    audience          = "resource-guru"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_resource_guru_customer_domain_resourceguruapp_com,
    citrixspa_routing_domain.rd_resource_guru_customer_fqdn,
  ]
}
