# Fulcrumapp — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_fulcrumapp_fulcrumapp_com" {
  fqdn         = "fulcrumapp.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Fulcrumapp"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_fulcrumapp_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Fulcrumapp"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_fulcrumapp" {
  name         = "Fulcrumapp"
  type         = "saas"
  state        = "complete"
  description  = "Create iOS and Android mobile forms in just minutes for fast, easy data collection anywhere, anytime"
  url          = "https://fulcrumapp.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Fulcrumapp"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://web.fulcrumapp.com/saml/consume?organization=<org-id>"
    audience          = "https://web.fulcrumapp.com/saml/consume?organization=<org-id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_fulcrumapp_fulcrumapp_com,
    citrixspa_routing_domain.rd_fulcrumapp_customer_fqdn,
  ]
}
