# ekarda — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_ekarda_www_ekarda_com" {
  fqdn         = "www.ekarda.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ekarda"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_ekarda_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ekarda"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_ekarda" {
  name         = "ekarda"
  type         = "saas"
  state        = "complete"
  description  = "Electronic card designing tool."
  url          = "https://www.ekarda.com/myecards/select_cardtypes"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "ekarda"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://www.ekarda.com/users/saml_acs/<Org-Id>"
    audience          = "https://www.ekarda.com/users/saml_metadata/<Org-Id>"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "unspecified"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name   = "email"
        value  = "ns_user_email"
        format = "unspecified"
      },
      {
        name   = "FirstName"
        value  = "ns_user_name"
        format = "unspecified"
      },
      {
        name   = "LastName"
        value  = "aaa.USER.ATTRIBUTE(\"sn\")"
        format = "unspecified"
      },
      {
        name   = "UserName"
        value  = "ns_user_name"
        format = "unspecified"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_ekarda_www_ekarda_com,
    citrixspa_routing_domain.rd_ekarda_customer_fqdn,
  ]
}
