# LeanKit — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_leankit_customer_domain_leankit_com" {
  fqdn         = "<Customer-domain>.leankit.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "LeanKit"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_leankit_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "LeanKit"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_leankit" {
  name         = "LeanKit"
  type         = "saas"
  state        = "complete"
  description  = "Kanban Software for Lean Project Management"
  url          = "https://<Customer-domain>.leankit.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "LeanKit"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<Customer-domain>.leankit.com/Account/Membership/ExternalLogin"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "unspecified"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_leankit_customer_domain_leankit_com,
    citrixspa_routing_domain.rd_leankit_customer_fqdn,
  ]
}
