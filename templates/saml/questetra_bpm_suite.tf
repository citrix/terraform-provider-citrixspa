# Questetra BPM Suite — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_questetra_bpm_suite_karasuma_ichijo_account_id_questetra_net" {
  fqdn         = "karasuma-ichijo-<Account-ID>.questetra.net"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Questetra BPM Suite"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_questetra_bpm_suite_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Questetra BPM Suite"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_questetra_bpm_suite" {
  name         = "Questetra BPM Suite"
  type         = "saas"
  state        = "complete"
  description  = "Web-based business process platform for routine workflows."
  url          = "https://karasuma-ichijo-<Account-ID>.questetra.net/Dashboard/Top/view"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Questetra BPM Suite"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://karasuma-ichijo-<Account-ID>.questetra.net/saml/SSO/alias/bpm"
    audience          = "https://karasuma-ichijo-<Account-ID>.questetra.net/"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_questetra_bpm_suite_karasuma_ichijo_account_id_questetra_net,
    citrixspa_routing_domain.rd_questetra_bpm_suite_customer_fqdn,
  ]
}
