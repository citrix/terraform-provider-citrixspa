# People HR — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_people_hr_customer_domain_peoplehr_net" {
  fqdn         = "<Customer-Domain>.peoplehr.net"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "People HR"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_people_hr_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "People HR"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_people_hr" {
  name         = "People HR"
  type         = "saas"
  state        = "complete"
  description  = "HR software system for all key HR functions."
  url          = "https://<Customer-Domain>.peoplehr.net/Pages/LeftSegment/Dashboard.aspx"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "People HR"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<Customer-Domain>.peoplehr.net/Pages/Saml/Consume.aspx"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_people_hr_customer_domain_peoplehr_net,
    citrixspa_routing_domain.rd_people_hr_customer_fqdn,
  ]
}
