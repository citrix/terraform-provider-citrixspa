# GlassFrog — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_glassfrog_app_glassfrog_com" {
  fqdn         = "app.glassfrog.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "GlassFrog"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_glassfrog_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "GlassFrog"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_glassfrog" {
  name         = "GlassFrog"
  type         = "saas"
  state        = "complete"
  description  = "Software to Holacracy practice."
  url          = "https://app.glassfrog.com/organizations/<customer_id>"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "GlassFrog"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.glassfrog.com/organizations/<customer_id>/saml"
    audience          = "https://app.glassfrog.com/organizations/<customer_id>/saml"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_glassfrog_app_glassfrog_com,
    citrixspa_routing_domain.rd_glassfrog_customer_fqdn,
  ]
}
