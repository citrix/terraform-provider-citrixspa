# TestFairy — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_testfairy_your_organization_testfairy_com" {
  fqdn         = "<your-organization>.testfairy.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "TestFairy"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_testfairy_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "TestFairy"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_testfairy" {
  name         = "TestFairy"
  type         = "saas"
  state        = "complete"
  description  = "Mobile testing platform, to provide companies with video recordings, logs, and crash reports of mobile sessions."
  url          = "https://<your-organization>.testfairy.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "TestFairy"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.testfairy.com/login/sso"
    audience          = "https://<your-organization>.testfairy.com"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_testfairy_your_organization_testfairy_com,
    citrixspa_routing_domain.rd_testfairy_customer_fqdn,
  ]
}
