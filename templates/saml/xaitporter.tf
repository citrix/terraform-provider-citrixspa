# XaitPorter — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_xaitporter_your_organization_xaitporter_com" {
  fqdn         = "<your-organization>.xaitporter.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "XaitPorter"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_xaitporter_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "XaitPorter"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_xaitporter" {
  name         = "XaitPorter"
  type         = "saas"
  state        = "complete"
  description  = "Document co-authoring software for bids and proposals and other business documents."
  url          = "https://<your-organization>.xaitporter.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "XaitPorter"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.xaitporter.com/saml/consumer"
    audience          = "https://<your-organization>.xaitporter.com"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP"
    sp_initiated_only = true
  }

  depends_on = [
    citrixspa_routing_domain.rd_xaitporter_your_organization_xaitporter_com,
    citrixspa_routing_domain.rd_xaitporter_customer_fqdn,
  ]
}
