# New Relic — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_new_relic_rpm_newrelic_com" {
  fqdn         = "rpm.newrelic.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "New Relic"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_new_relic_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "New Relic"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_new_relic" {
  name         = "New Relic"
  type         = "saas"
  state        = "complete"
  description  = "Digital intelligence platform to measure and monitor the performance of applications and infrastructure."
  url          = "https://rpm.newrelic.com/accounts/<customer_id>/setup"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "New Relic"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://rpm.newrelic.com:443/accounts/<customer_id>/sso/saml/finalize"
    audience          = "rpm.newrelic.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_new_relic_rpm_newrelic_com,
    citrixspa_routing_domain.rd_new_relic_customer_fqdn,
  ]
}
