# playvox — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_playvox_your_organization_playvox_com" {
  fqdn         = "<your-organization>.playvox.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "playvox"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_playvox_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "playvox"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_playvox" {
  name         = "playvox"
  type         = "saas"
  state        = "complete"
  description  = "Customer service quality monitoring tool."
  url          = "https://<your-organization>.playvox.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "playvox"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://my.playvox.com/saml/consumer"
    audience          = "https://my.playvox.com/saml/audience"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_playvox_your_organization_playvox_com,
    citrixspa_routing_domain.rd_playvox_customer_fqdn,
  ]
}
