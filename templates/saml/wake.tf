# Wake — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_wake_your_organization_wake_com" {
  fqdn         = "<your-organization>.wake.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Wake"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_wake_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Wake"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_wake" {
  name         = "Wake"
  type         = "saas"
  state        = "complete"
  description  = "Design Collaboration and Feedback for Teams"
  url          = "https://<your-organization>.wake.com/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Wake"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.wake.com/saml2/acs"
    audience          = "https://<your-organization>.wake.com/saml2/metadata"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "persistent"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_wake_your_organization_wake_com,
    citrixspa_routing_domain.rd_wake_customer_fqdn,
  ]
}
