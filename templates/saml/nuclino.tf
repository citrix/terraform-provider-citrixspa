# Nuclino — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_nuclino_app_nuclino_com" {
  fqdn         = "app.nuclino.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Nuclino"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_nuclino_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Nuclino"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_nuclino" {
  name         = "Nuclino"
  type         = "saas"
  state        = "complete"
  description  = "Collaboration software to collaborate and share information in real-time."
  url          = "https://app.nuclino.com/<Customer_domain>"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Nuclino"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://api.nuclino.com/api/sso/<Customer_id>/acs"
    audience          = "https://api.nuclino.com/api/sso/<Customer_id>/metadata"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_nuclino_app_nuclino_com,
    citrixspa_routing_domain.rd_nuclino_customer_fqdn,
  ]
}
