# LaunchDarkly — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_launchdarkly_app_launchdarkly_com" {
  fqdn         = "app.launchdarkly.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "LaunchDarkly"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_launchdarkly_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "LaunchDarkly"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_launchdarkly" {
  name         = "LaunchDarkly"
  type         = "saas"
  state        = "complete"
  description  = "Feature management platform to enable dev and ops teams to control the feature lifecycle."
  url          = "https://app.launchdarkly.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "LaunchDarkly"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.launchdarkly.com/trust/saml2/acs/<customer_id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_launchdarkly_app_launchdarkly_com,
    citrixspa_routing_domain.rd_launchdarkly_customer_fqdn,
  ]
}
