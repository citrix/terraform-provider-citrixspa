# DEPUTY — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_deputy_your_organization_location_code_deputy_com" {
  fqdn         = "<your-organization>.<location-code>.deputy.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "DEPUTY"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_deputy_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "DEPUTY"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_deputy" {
  name         = "DEPUTY"
  type         = "saas"
  state        = "complete"
  description  = "Workforce management tool for scheduling and tracking employees' time, tasks, and communication."
  url          = "https://<your-organization>.<location-code>.deputy.com/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "DEPUTY"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.<location-code>.deputy.com/exec/devapp/samlacs"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_deputy_your_organization_location_code_deputy_com,
    citrixspa_routing_domain.rd_deputy_customer_fqdn,
  ]
}
