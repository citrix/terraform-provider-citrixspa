# MyWebTimesheets — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_mywebtimesheets_your_organization_mywebtimesheets_com" {
  fqdn         = "<your-organization>.mywebtimesheets.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "MyWebTimesheets"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_mywebtimesheets_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "MyWebTimesheets"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_mywebtimesheets" {
  name         = "MyWebTimesheets"
  type         = "saas"
  state        = "complete"
  description  = "Online time tracking system to track time spent on various projects jobs activities."
  url          = "https://<your-organization>.mywebtimesheets.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "MyWebTimesheets"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization>.mywebtimesheets.com/samllogin.aspx"
    audience          = "https://<your-organization>.mywebtimesheets.com"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP"
    sp_initiated_only = true
  }

  depends_on = [
    citrixspa_routing_domain.rd_mywebtimesheets_your_organization_mywebtimesheets_com,
    citrixspa_routing_domain.rd_mywebtimesheets_customer_fqdn,
  ]
}
