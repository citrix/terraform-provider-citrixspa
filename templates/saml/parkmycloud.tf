# ParkMyCloud — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_parkmycloud_console_parkmycloud_com" {
  fqdn         = "console.parkmycloud.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ParkMyCloud"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_parkmycloud_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ParkMyCloud"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_parkmycloud" {
  name         = "ParkMyCloud"
  type         = "saas"
  state        = "complete"
  description  = "Single-purpose SaaS tool to connects to AWS, Azure Services, or GCP."
  url          = "https://console.parkmycloud.com/#/cloud-credentials/add/step1/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "ParkMyCloud"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://console.parkmycloud.com/saml/sso/<Customer_Id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name   = "First Name"
        value  = "aaa.user.attribute(\"givenName\")"
        format = "unspecified"
      },
      {
        name   = "Last Name"
        value  = "aaa.user.attribute(\"sn\")"
        format = "unspecified"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_parkmycloud_console_parkmycloud_com,
    citrixspa_routing_domain.rd_parkmycloud_customer_fqdn,
  ]
}
