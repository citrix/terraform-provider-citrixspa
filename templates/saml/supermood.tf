# Supermood — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_supermood_preprod_supermood_co" {
  fqdn         = "preprod.supermood.co"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Supermood"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_supermood_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Supermood"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_supermood" {
  name         = "Supermood"
  type         = "saas"
  state        = "complete"
  description  = "HR platform to gather feedback of employee in real-time."
  url          = "https://preprod.supermood.co/auth/sso/saml20"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Supermood"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://preprod.supermood.co/auth/sso/saml20/acs"
    relay_state       = "https://preprod.supermood.co/auth/sso/saml20"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_supermood_preprod_supermood_co,
    citrixspa_routing_domain.rd_supermood_customer_fqdn,
  ]
}
