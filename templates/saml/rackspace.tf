# Rackspace — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_rackspace_portal_rackspace_com" {
  fqdn         = "portal.rackspace.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Rackspace"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_rackspace_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Rackspace"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_rackspace" {
  name         = "Rackspace"
  type         = "saas"
  state        = "complete"
  description  = "Managed cloud computing services."
  url          = "https://portal.rackspace.com/<account_no>/dashboard"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Rackspace"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://login.rackspace.com/federate/acs"
    audience          = "https://login.rackspace.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "firstname"
        value = "aaa.user.attribute(\"givenName\")"
      },
      {
        name  = "email"
        value = "ns_user_email"
      },
      {
        name  = "lastname"
        value = "aaa.user.attribute(\"sn\")"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_rackspace_portal_rackspace_com,
    citrixspa_routing_domain.rd_rackspace_customer_fqdn,
  ]
}
