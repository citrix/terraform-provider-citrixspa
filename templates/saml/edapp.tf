# Edapp — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_edapp_admin_edapp_com" {
  fqdn         = "admin.edapp.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Edapp"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_edapp_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Edapp"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_edapp" {
  name         = "Edapp"
  type         = "saas"
  state        = "complete"
  description  = "Learning management tool for workspace learning."
  url          = "https://admin.edapp.com/home"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Edapp"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://api.edapp.com/sso-saml-callback/<customer_id>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_edapp_admin_edapp_com,
    citrixspa_routing_domain.rd_edapp_customer_fqdn,
  ]
}
