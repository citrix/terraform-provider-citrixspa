# CloudAMQP — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_cloudamqp_customer_cloudamqp_com" {
  fqdn         = "customer.cloudamqp.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "CloudAMQP"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_cloudamqp_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "CloudAMQP"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_cloudamqp" {
  name         = "CloudAMQP"
  type         = "saas"
  state        = "complete"
  description  = "Message queue tool to pass messages between processes and other systems."
  url          = "https://customer.cloudamqp.com/login"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "CloudAMQP"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://customer.cloudamqp.com/login/saml"
    audience          = "https://customer.cloudamqp.com/saml/metadata"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_cloudamqp_customer_cloudamqp_com,
    citrixspa_routing_domain.rd_cloudamqp_customer_fqdn,
  ]
}
