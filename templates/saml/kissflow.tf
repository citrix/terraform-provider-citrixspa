# KiSSFLOW — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_kissflow_customer_domain_appspot_com" {
  fqdn         = "<customer-domain>.appspot.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "KiSSFLOW"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_kissflow_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "KiSSFLOW"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_kissflow" {
  name         = "KiSSFLOW"
  type         = "saas"
  state        = "complete"
  description  = "Workflow tool and business process workflow management software to automate your workflow process."
  url          = "https://<customer-domain>.appspot.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "KiSSFLOW"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.kissflow.com/<customer_id>/f/saml/login?acs"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_kissflow_customer_domain_appspot_com,
    citrixspa_routing_domain.rd_kissflow_customer_fqdn,
  ]
}
