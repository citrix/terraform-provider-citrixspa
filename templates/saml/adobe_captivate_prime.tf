# Adobe Captivate Prime — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_adobe_captivate_prime_captivateprime_adobe_com" {
  fqdn         = "captivateprime.adobe.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Adobe Captivate Prime"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_adobe_captivate_prime_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Adobe Captivate Prime"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_adobe_captivate_prime" {
  name         = "Adobe Captivate Prime"
  type         = "saas"
  state        = "complete"
  description  = "Learning management system to deliver personalized learning experiences across devices."
  url          = "https://captivateprime.adobe.com/saml/sso"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Adobe Captivate Prime"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://captivateprime.adobe.com/saml/sso"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_adobe_captivate_prime_captivateprime_adobe_com,
    citrixspa_routing_domain.rd_adobe_captivate_prime_customer_fqdn,
  ]
}
