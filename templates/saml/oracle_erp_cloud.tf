# Oracle ERP Cloud — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_oracle_erp_cloud_your_organization_id_identity_oraclecloud_com" {
  fqdn         = "<your-organization-id>.identity.oraclecloud.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Oracle ERP Cloud"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_oracle_erp_cloud_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Oracle ERP Cloud"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_oracle_erp_cloud" {
  name         = "Oracle ERP Cloud"
  type         = "saas"
  state        = "complete"
  description  = "Cloud-based software application suite to manages enterprise functions."
  url          = "https://<your-organization-id>.identity.oraclecloud.com/ui/v1/adminconsole/?root=security&security=external-idp"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Oracle ERP Cloud"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-organization-id>.identity.oraclecloud.com/fed/v1/sp/sso"
    audience          = "https://<your-organization-id>.identity-test.oraclecloud.com/fed"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "Username"
        value = "ns_user_name"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_oracle_erp_cloud_your_organization_id_identity_oraclecloud_com,
    citrixspa_routing_domain.rd_oracle_erp_cloud_customer_fqdn,
  ]
}
