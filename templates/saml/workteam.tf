# Workteam — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_workteam_app_workte_am" {
  fqdn         = "app.workte.am"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Workteam"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_workteam_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Workteam"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_workteam" {
  name         = "Workteam"
  type         = "saas"
  state        = "complete"
  description  = "Tool to track employee time and attendance."
  url          = "https://app.workte.am/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Workteam"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://app.workte.am/_saml/validate/saml"
    audience          = "https://workte.am/saml/sp"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_workteam_app_workte_am,
    citrixspa_routing_domain.rd_workteam_customer_fqdn,
  ]
}
