# ConceptShare — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_conceptshare_customer_domain_conceptshare_com" {
  fqdn         = "<customer-domain>.conceptshare.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ConceptShare"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_conceptshare_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "ConceptShare"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_conceptshare" {
  name         = "ConceptShare"
  type         = "saas"
  state        = "complete"
  description  = "Proofing tool to deliver content faster, quicker, and cheaper."
  url          = "https://<customer-domain>.conceptshare.com/#/projects"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "ConceptShare"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.conceptshare.com/saml.ashx"
    audience          = "https://<Customer-Domain>.conceptshare.com/"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname"
        value = "aaa.user.attribute(\"givenName\")"
      },
      {
        name  = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"
        value = "ns_user_email"
      },
      {
        name  = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname"
        value = "aaa.user.attribute(\"sn\")"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_conceptshare_customer_domain_conceptshare_com,
    citrixspa_routing_domain.rd_conceptshare_customer_fqdn,
  ]
}
