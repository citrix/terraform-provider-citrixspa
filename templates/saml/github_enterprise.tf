# GitHub Enterprise — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_github_enterprise_your_github_enterprise" {
  fqdn         = "<your-github-enterprise>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "GitHub Enterprise"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_github_enterprise_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "GitHub Enterprise"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_github_enterprise" {
  name         = "GitHub Enterprise"
  type         = "saas"
  state        = "complete"
  description  = "On-premises version of GitHub"
  url          = "https://<your-github-enterprise>"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "GitHub Enterprise"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-github-enterprise>/saml/consume"
    audience          = "https://<your-github-enterprise>"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "persistent"
    saml_type         = "SP_IDP"
    sp_initiated_only = false

    custom_attributes = [
      {
        name  = "emails"
        value = "ns_user_email"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_github_enterprise_your_github_enterprise,
    citrixspa_routing_domain.rd_github_enterprise_customer_fqdn,
  ]
}
