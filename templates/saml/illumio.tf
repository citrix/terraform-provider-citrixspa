# illumio — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_illumio_your_org_issuer_illum_io" {
  fqdn         = "<your-Org-Issuer>.illum.io"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "illumio"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_illumio_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "illumio"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_illumio" {
  name         = "illumio"
  type         = "saas"
  state        = "complete"
  description  = "Security system to prevent spread of breaches inside data center and cloud environments."
  url          = "https://<your-Org-Issuer>.illum.io/login"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "illumio"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<your-Org-Issuer>.illum.io/login/acs/<your-org-Id>"
    audience          = "https://<your-Org-Issuer>.illum.io/login"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_illumio_your_org_issuer_illum_io,
    citrixspa_routing_domain.rd_illumio_customer_fqdn,
  ]
}
