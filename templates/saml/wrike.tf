# Wrike — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_wrike_www_wrike_com" {
  fqdn         = "www.wrike.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Wrike"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_wrike_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Wrike"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_wrike" {
  name         = "Wrike"
  type         = "saas"
  state        = "complete"
  description  = "Software-as-a-Service SaaS product that helps you accelerate work that matters most with all activities, projects and workflows, in a unified workplace"
  url          = "https://www.wrike.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Wrike"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://login.wrike.com/saml/SSO"
    audience          = "https://www.wrike.com"
    relay_state       = "https://www.wrike.com"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_wrike_www_wrike_com,
    citrixspa_routing_domain.rd_wrike_customer_fqdn,
  ]
}
