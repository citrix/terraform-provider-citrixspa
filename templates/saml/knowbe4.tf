# KnowBe4 — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_knowbe4_training_knowbe4_com" {
  fqdn         = "training.knowbe4.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "KnowBe4"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_knowbe4_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "KnowBe4"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_knowbe4" {
  name         = "KnowBe4"
  type         = "saas"
  state        = "complete"
  description  = "Tool to provide security awareness training and simulated phishing."
  url          = "https://training.knowbe4.com/dashboard/index"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "KnowBe4"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://training.knowbe4.com/auth/saml/<customer_domain>/callback"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_knowbe4_training_knowbe4_com,
    citrixspa_routing_domain.rd_knowbe4_customer_fqdn,
  ]
}
