# intelligent contract — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_intelligent_contract_portal_intelligentcontract_com" {
  fqdn         = "portal.intelligentcontract.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "intelligent contract"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_intelligent_contract_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "intelligent contract"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_intelligent_contract" {
  name         = "intelligent contract"
  type         = "saas"
  state        = "complete"
  description  = "Web based contract management software."
  url          = "https://portal.intelligentcontract.com/portal/contracts/dashboard"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "intelligent contract"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://portal.intelligentcontract.com/saml/acs?idp=saml&customerId=<customer_ID>"
    audience          = "https://portal.intelligentcontract.com/saml/metadata?idp=saml&customerId=<Customer_ID>"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_intelligent_contract_portal_intelligentcontract_com,
    citrixspa_routing_domain.rd_intelligent_contract_customer_fqdn,
  ]
}
