# Visual Paradigm Online — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_visual_paradigm_online_online_visual_paradigm_com" {
  fqdn         = "online.visual-paradigm.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Visual Paradigm Online"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_visual_paradigm_online_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Visual Paradigm Online"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_visual_paradigm_online" {
  name         = "Visual Paradigm Online"
  type         = "saas"
  state        = "complete"
  description  = "Online Diagram Software and Chart Solution"
  url          = "https://online.visual-paradigm.com/w/wwxizqnb/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Visual Paradigm Online"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://online.visual-paradigm.com/w/wwxizqnb/saml2/service/"
    audience          = "https://online.visual-paradigm.com/w/wwxizqnb/saml2/"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP_IDP"
    sp_initiated_only = false
  }

  depends_on = [
    citrixspa_routing_domain.rd_visual_paradigm_online_online_visual_paradigm_com,
    citrixspa_routing_domain.rd_visual_paradigm_online_customer_fqdn,
  ]
}
