# Syncplicity — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_syncplicity_companyname_syncplicity_com" {
  fqdn         = "<companyname>.syncplicity.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Syncplicity"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_syncplicity_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Syncplicity"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_syncplicity" {
  name         = "Syncplicity"
  type         = "saas"
  state        = "complete"
  description  = "Tool to share and synchronize files."
  url          = "https://<companyname>.syncplicity.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Syncplicity"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<yourorg-domain>.syncplicity.com/Auth/AssertionConsumerService.aspx"
    sign_assertion    = "BOTH"
    name_id_source    = "email"
    name_id_format    = "emailAddress"
    saml_type         = "SP"
    sp_initiated_only = true
  }

  depends_on = [
    citrixspa_routing_domain.rd_syncplicity_companyname_syncplicity_com,
    citrixspa_routing_domain.rd_syncplicity_customer_fqdn,
  ]
}
