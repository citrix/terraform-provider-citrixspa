# Citrix RightSignature — SPA saas application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_citrix_rightsignature_customer_domain_sharefile_com" {
  fqdn         = "<customer-domain>.sharefile.com"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Citrix RightSignature"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_citrix_rightsignature_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "saas"
  flag         = "enabled"
  comment      = "Citrix RightSignature"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_citrix_rightsignature" {
  name         = "Citrix RightSignature"
  type         = "saas"
  state        = "complete"
  description  = "Electronic signature capability provided by Citrix RightSignature."
  url          = "https://<customer-domain>.sharefile.com/saml/login?oauth=1&email=&client_id=hHemsAdC6Jg7hwKVQU9NBf1D1JBLZ6LM&state=&redirect_uri=https%3A%2F%2Fsecure.rightsignature.com%2Fsharefile-redirect&response_type=code&h=&subdomain=<customer-domain>&appcp=sharefile.com&apicp=sf-api.com"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "Citrix RightSignature"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type              = "saml"
    assertion_url     = "https://<customer-domain>.sharefile.com/saml/acs"
    sign_assertion    = "ASSERTION"
    name_id_source    = "email"
    name_id_format    = "persistent"
    saml_type         = "SP"
    sp_initiated_only = true

    custom_attributes = [
      {
        name  = "mail"
        value = "ns_user_email"
      },
    ]
  }

  depends_on = [
    citrixspa_routing_domain.rd_citrix_rightsignature_customer_domain_sharefile_com,
    citrixspa_routing_domain.rd_citrix_rightsignature_customer_fqdn,
  ]
}
