# SharePoint — SPA web application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_sharepoint_customer_url" {
  fqdn         = "<customer-url>"
  type         = "external"
  app_type     = "web"
  flag         = "enabled"
  comment      = "SharePoint"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_sharepoint_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "web"
  flag         = "enabled"
  comment      = "SharePoint"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_sharepoint" {
  name         = "SharePoint"
  type         = "web"
  state        = "complete"
  description  = "Collaborative platform used for document management and storage."
  url          = "http://<customer-url>/_forms/default.aspx"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "SharePoint"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type           = "form"
    action_url     = "default.aspx?ReturnUrl=/_layouts/Authenticate.aspx?Source=%2FSitePages%2FHome%2Easpx&Source=/SitePages/Home.asp"
    logonform_url  = "/_forms/default.aspx"
    username_field = "ctl00$PlaceHolderMain$signInControl$UserName"
    password_field = "ctl00$PlaceHolderMain$signInControl$password"
  }

  depends_on = [
    citrixspa_routing_domain.rd_sharepoint_customer_url,
    citrixspa_routing_domain.rd_sharepoint_customer_fqdn,
  ]
}
