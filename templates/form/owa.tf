# OWA — SPA web application template
# Source: SPA SaaS app catalog (internal), sourced 2026-09-17.
# Replace <placeholder> values (URLs, related URLs) before running terraform apply.

resource "citrixspa_routing_domain" "rd_owa_customer_domain_owa_com" {
  fqdn         = "<customer-domain>.owa.com"
  type         = "external"
  app_type     = "web"
  flag         = "enabled"
  comment      = "OWA"
  ip           = false
  location_ids = []
}

resource "citrixspa_routing_domain" "rd_owa_customer_fqdn" {
  fqdn         = "<Customer FQDN>"
  type         = "external"
  app_type     = "web"
  flag         = "enabled"
  comment      = "OWA"
  ip           = false
  location_ids = []
}

resource "citrixspa_application" "app_owa" {
  name         = "OWA"
  type         = "web"
  state        = "complete"
  description  = "Web-based email client from Microsoft."
  url          = "https://<customer-domain>.owa.com/?next=/account/profile/"
  related_urls = ["<Customer FQDN>"]
  icon         = ""

  using_template   = true
  template_name    = "OWA"
  hidden           = false
  agentless_access = false
  mobile_security  = false
  sbs_only_launch  = false

  sso = {
    type           = "form"
    action_url     = "/owa/auth/owaauth.dll"
    logonform_url  = "/owa/auth/logon.aspx"
    username_field = "username"
    password_field = "Password"
  }

  depends_on = [
    citrixspa_routing_domain.rd_owa_customer_domain_owa_com,
    citrixspa_routing_domain.rd_owa_customer_fqdn,
  ]
}
